<?xml version="1.0" encoding="utf-8"?>
<!-- One round tap target that stays circular in any cell shape (fitCenter keeps the 1:1 drawable).
     The description is read by TalkBack; no text is shown. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/widget_content_description"
    android:padding="4dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_button"
        android:importantForAccessibility="no" />
</FrameLayout>
