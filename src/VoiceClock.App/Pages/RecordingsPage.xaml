<?xml version="1.0" encoding="utf-8" ?>
<!-- Guided recording checklist: every clip, its status, and play / record / restore actions. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VoiceClock.Core.ViewModels;assembly=VoiceClock.Core"
             xmlns:res="clr-namespace:VoiceClock.Core.Resources;assembly=VoiceClock.Core"
             x:Class="VoiceClock.App.Pages.RecordingsPage"
             x:DataType="vm:RecordingsViewModel"
             Title="{x:Static res:Strings.Recordings_Title}">

    <CollectionView ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" Margin="12,0">

        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Padding="6,14,6,4">
                <Button Text="{x:Static res:Strings.Setup_RecordNextMissing}"
                        Command="{Binding RecordNextMissingCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Label Text="{Binding Message}" TextColor="{StaticResource Primary}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:Strings.Category_FullPhrase}" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Label Text="{x:Static res:Strings.Recordings_FullPhraseHint}" Style="{StaticResource Hint}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Picker Grid.Column="0" ItemsSource="{Binding HourOptions}" SelectedIndex="{Binding PhraseHourIndex}" Title="{x:Static res:Strings.Setup_TestHour}" />
                            <Picker Grid.Column="1" ItemsSource="{Binding MinuteOptions}" SelectedIndex="{Binding PhraseMinute}" Title="{x:Static res:Strings.Setup_TestMinute}" />
                        </Grid>
                        <Label Text="{Binding PhrasePreviewText}" FontAttributes="Bold" />
                        <Button Text="{x:Static res:Strings.Recordings_AddFullPhrase}" Command="{Binding AddFullPhraseCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:ClipGroupViewModel">
                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" Padding="6,18,6,6" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipItemViewModel">
                <Border Style="{StaticResource Card}" Margin="0,4" Padding="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                        <Label Grid.ColumnSpan="3" Text="{Binding Text}" FontSize="22" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource Hint}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding NeedsAttention}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Danger}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUserRecording}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Grid.Row="1" Grid.Column="1"
                                Text="{x:Static res:Strings.Recordings_Play}"
                                IsEnabled="{Binding IsReady}"
                                Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type vm:RecordingsViewModel}}, x:DataType=vm:RecordingsViewModel}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Text="{x:Static res:Strings.Recordings_Record}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:RecordingsViewModel}}, x:DataType=vm:RecordingsViewModel}"
                                CommandParameter="{Binding .}" />
                        <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="3" Spacing="8">
                            <Button Text="{x:Static res:Strings.Recordings_RestoreDefault}"
                                    IsVisible="{Binding CanRestoreDefault}"
                                    Command="{Binding RestoreDefaultCommand, Source={RelativeSource AncestorType={x:Type vm:RecordingsViewModel}}, x:DataType=vm:RecordingsViewModel}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="{x:Static res:Strings.Recordings_Delete}"
                                    IsVisible="{Binding CanDelete}"
                                    TextColor="{StaticResource Danger}"
                                    Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:RecordingsViewModel}}, x:DataType=vm:RecordingsViewModel}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="40" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
